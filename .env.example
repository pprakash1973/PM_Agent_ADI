# Database — any PostgreSQL-compatible URL works (Neon, Azure, Railway)
# Neon:  postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# Azure: postgresql://user@server:pass@server.postgres.database.azure.com:5432/db?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/pmAgent?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Optional: OpenAI (used for multi-provider model routing)
OPENAI_API_KEY=""

# File storage (local in dev; set an absolute path in Azure App Service)
UPLOAD_DIR="./uploads"

# ── Azure Document Intelligence ──────────────────────────────────────────────
AZURE_DI_ENDPOINT="https://pm-agent-di-dev.cognitiveservices.azure.com"
AZURE_DI_KEY=""
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="pm-agent-docs"

# ── Azure deployment notes ────────────────────────────────────────────────────
# Set these as GitHub Actions secrets: DATABASE_URL, NEXTAUTH_SECRET,
#   NEXTAUTH_URL, ANTHROPIC_API_KEY, RESEND_API_KEY, EMAIL_FROM,
#   OPENAI_API_KEY, AZURE_WEBAPP_PUBLISH_PROFILE
# Set AZURE_WEBAPP_NAME as a GitHub Actions variable (not a secret).
# In Azure App Service → Configuration, set all the above as App Settings.
# NEXTAUTH_URL must match the deployed app URL (e.g. https://pmAgent.azurewebsites.net)
